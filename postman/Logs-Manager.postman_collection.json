{
  "info": {
    "name": "Logs Manager API",
    "description": "Canonical Postman collection for the Logs Manager (Mini SIEM) API. Start by logging in; Postman stores the auth cookies for subsequent requests. Ingestion requests use X-API-Key."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4500"
    },
    {
      "key": "apiKey",
      "value": "dev-ingest-key-change-me"
    },
    {
      "key": "tenant",
      "value": "demoa"
    },
    {
      "key": "adminEmail",
      "value": "admin@demo.local"
    },
    {
      "key": "adminPassword",
      "value": "{{SEED_ADMIN_PASSWORD}}"
    },
    {
      "key": "viewerEmail",
      "value": "viewerA@demo.local"
    },
    {
      "key": "viewerPassword",
      "value": "{{SEED_VIEWER_A_PASSWORD}}"
    },
    {
      "key": "alertId",
      "value": ""
    },
    {
      "key": "ruleId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "tenantName",
      "value": "demoa"
    },
    {
      "key": "newTenantName",
      "value": "demob"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check (liveness)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/healthz"
          },
          "response": []
        },
        {
          "name": "Readiness check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ready"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "response": [],
          "description": "Login with email/password. Sets auth cookies used by later requests."
        },
        {
          "name": "Auth check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/auth-check"
          },
          "response": [],
          "description": "Verify the current session."
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout"
          },
          "response": [],
          "description": "Clear session cookies."
        }
      ]
    },
    {
      "name": "Ingestion - /api",
      "item": [
        {
          "name": "Single event - POST /api/ingest",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/ingest",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"api\",\n  \"tenant\": \"{{tenant}}\",\n  \"event_type\": \"app_login_failed\",\n  \"user\": \"alice\",\n  \"src_ip\": \"203.0.113.7\",\n  \"reason\": \"wrong_password\",\n  \"severity\": 5\n}"
            }
          },
          "response": [],
          "description": "Requires X-API-Key. Tenant is resolved from the API key."
        },
        {
          "name": "Batch events - POST /api/ingest/batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/ingest/batch",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant\": \"{{tenant}}\",\n  \"events\": [\n    {\n      \"source\": \"api\",\n      \"event_type\": \"batch_event_1\",\n      \"user\": \"alice\"\n    },\n    {\n      \"source\": \"aws\",\n      \"eventName\": \"CreateUser\",\n      \"eventSource\": \"iam.amazonaws.com\"\n    }\n  ]\n}"
            }
          },
          "response": [],
          "description": "Requires X-API-Key."
        },
        {
          "name": "File upload - POST /api/ingest/file",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "text",
                  "value": "samples/batch_sample.jsonl"
                },
                {
                  "key": "source",
                  "type": "text",
                  "value": "{{tenant}}"
                }
              ]
            },
            "url": "{{baseUrl}}/api/ingest/file",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ]
          },
          "response": [],
          "description": "Requires X-API-Key. Select a JSON/JSONL/CSV/syslog file in Postman."
        },
        {
          "name": "HTTPS syslog - POST /api/ingest/syslog",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/ingest/syslog",
            "body": {
              "mode": "raw",
              "raw": "<134>Aug 20 12:44:56 fw01 vendor=demo product=ngfw action=deny src=10.0.1.10 dst=8.8.8.8 spt=5353 dpt=53 proto=udp msg=\"DNS blocked\" policy=Block-DNS"
            }
          },
          "response": [],
          "description": "SaaS HTTPS syslog ingestion. Requires X-API-Key; the tenant comes from that key. Accepts newline-delimited text/plain or {\"lines\":[...]} JSON. Native UDP/TCP Syslog is available only in self-hosted Docker, not Render."
        }
      ]
    },
    {
      "name": "Ingestion - assignment exact paths",
      "item": [
        {
          "name": "Single event - POST /ingest",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/ingest",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"api\",\n  \"tenant\": \"{{tenant}}\",\n  \"event_type\": \"app_login_failed\",\n  \"user\": \"alice\",\n  \"src_ip\": \"203.0.113.7\",\n  \"reason\": \"wrong_password\",\n  \"severity\": 5\n}"
            }
          },
          "response": [],
          "description": "Unprefixed alias required by the assignment. Requires X-API-Key."
        },
        {
          "name": "Batch events - POST /ingest/batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/ingest/batch",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant\": \"{{tenant}}\",\n  \"events\": [\n    {\n      \"source\": \"api\",\n      \"event_type\": \"batch_event_1\",\n      \"user\": \"alice\"\n    },\n    {\n      \"source\": \"aws\",\n      \"eventName\": \"CreateUser\",\n      \"eventSource\": \"iam.amazonaws.com\"\n    }\n  ]\n}"
            }
          },
          "response": [],
          "description": "Unprefixed alias required by the assignment. Requires X-API-Key."
        },
        {
          "name": "File upload - POST /ingest/file",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "text",
                  "value": "samples/batch_sample.jsonl"
                },
                {
                  "key": "source",
                  "type": "text",
                  "value": "{{tenant}}"
                }
              ]
            },
            "url": "{{baseUrl}}/ingest/file",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ]
          },
          "response": [],
          "description": "Unprefixed alias required by the assignment. Requires X-API-Key."
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List events - GET /api/events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?limit=50&tenant={{tenant}}"
          },
          "response": [],
          "description": "List events with optional filters."
        },
        {
          "name": "List logs (legacy alias) - GET /api/get-logs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/get-logs?limit=50&tenant={{tenant}}"
          },
          "response": [],
          "description": "Same handler as /api/events."
        },
        {
          "name": "Search by event type",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?limit=50&tenant={{tenant}}&event_type=app_login_failed"
          },
          "response": []
        },
        {
          "name": "Search by source IP",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?limit=50&tenant={{tenant}}&src_ip=203.0.113.7"
          },
          "response": []
        },
        {
          "name": "Filter by severity (high)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?limit=50&tenant={{tenant}}&severity=high"
          },
          "response": []
        },
        {
          "name": "Delete log (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/delete-log/{{logId}}"
          },
          "response": [],
          "description": "Set the logId collection variable first."
        }
      ]
    },
    {
      "name": "Dashboard and stats",
      "item": [
        {
          "name": "Dashboard - GET /api/dashboard",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/dashboard?tenant={{tenant}}&range=7d"
          },
          "response": []
        },
        {
          "name": "Aggregate counts - GET /api/get-all-data",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/get-all-data?tenant={{tenant}}"
          },
          "response": []
        },
        {
          "name": "Stats summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/stats/summary?tenant={{tenant}}"
          },
          "response": []
        },
        {
          "name": "Stats top",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/stats/top?field=src_ip&n=10&tenant={{tenant}}"
          },
          "response": []
        },
        {
          "name": "Stats timeline",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/stats/timeline?from=2020-01-01T00:00:00Z&interval=1d&tenant={{tenant}}"
          },
          "response": []
        },
        {
          "name": "Sources health (Admin)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sources/health?tenant={{tenant}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Alerts",
      "item": [
        {
          "name": "List alerts - GET /api/get-alerts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/get-alerts?limit=25&tenant={{tenant}}"
          },
          "response": []
        },
        {
          "name": "Update alert status (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/alerts/{{alertId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"resolved\"\n}"
            }
          },
          "response": [],
          "description": "Set alertId from the list response."
        }
      ]
    },
    {
      "name": "Alert rules",
      "item": [
        {
          "name": "List rules - GET /api/get-rules",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/get-rules?limit=25&tenant={{tenant}}"
          },
          "response": []
        },
        {
          "name": "Create rule - POST /api/create-alertRule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/create-alertRule",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Brute force detection\",\n  \"description\": \"Triggers when 5+ failed logins from the same IP within 5 minutes\",\n  \"tenant\": \"{{tenant}}\",\n  \"enabled\": true,\n  \"severity\": \"high\",\n  \"conditions\": [\n    {\n      \"type\": \"repeated_failures\",\n      \"groupBy\": \"src_ip\",\n      \"threshold\": 5,\n      \"windowSeconds\": 300\n    }\n  ]\n}"
            }
          },
          "response": []
        },
        {
          "name": "Update rule - PUT /api/update-rule/{id}",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/update-rule/{{ruleId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Brute force detection (updated)\",\n  \"description\": \"Updated by Postman\",\n  \"severity\": \"critical\",\n  \"enabled\": true\n}"
            }
          },
          "response": []
        },
        {
          "name": "Test rule - POST /api/rules/{id}/test",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/rules/{{ruleId}}/test"
          },
          "response": [],
          "description": "Dry run; creates nothing."
        },
        {
          "name": "Toggle rule enabled - PATCH /api/rules/{id}/enabled",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/rules/{{ruleId}}/enabled?enabled=true"
          },
          "response": [],
          "description": "enabled is a query parameter."
        },
        {
          "name": "Delete rule - DELETE /api/delete-rule/{id}",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/delete-rule/{{ruleId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users (Admin)",
      "item": [
        {
          "name": "List users - GET /api/get-users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/get-users?tenant={{tenant}}&limit=25"
          },
          "response": []
        },
        {
          "name": "Create user - POST /api/create-user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newviewer\",\n  \"email\": \"newviewer@demo.local\",\n  \"tenant\": \"{{tenant}}\",\n  \"role\": \"VIEWER\",\n  \"status\": \"ACTIVE\",\n  \"password\": \"ChangeMe123!\"\n}"
            },
            "url": "{{baseUrl}}/api/create-user"
          },
          "response": [],
          "description": "JSON body (form-encoded is also accepted)."
        },
        {
          "name": "Update user - PUT /api/update-user",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{userId}},\n  \"role\": \"VIEWER\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/api/update-user"
          },
          "response": [],
          "description": "JSON body (form-encoded is also accepted). Set userId first."
        },
        {
          "name": "Delete user - DELETE /api/delete-user/{id}",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/delete-user/{{userId}}"
          },
          "response": [],
          "description": "Set userId first."
        }
      ]
    },
    {
      "name": "Tenants (Admin)",
      "item": [
        {
          "name": "List tenants - GET /api/tenants",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tenants"
          },
          "response": []
        },
        {
          "name": "Create tenant - POST /api/tenants",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tenants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{newTenantName}}\",\n  \"is_active\": true\n}"
            }
          },
          "response": [],
          "description": "The response returns the API key once."
        },
        {
          "name": "Activate/deactivate tenant - PATCH /api/tenants/{name}",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tenants/{{newTenantName}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": true\n}"
            }
          },
          "response": []
        },
        {
          "name": "Rotate tenant API key - POST /api/tenants/{name}/rotate-key",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/tenants/{{newTenantName}}/rotate-key"
          },
          "response": [],
          "description": "The old key is invalidated immediately."
        }
      ]
    }
  ]
}
