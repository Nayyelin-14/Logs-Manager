# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=4500

# Database (local PostgreSQL for testing)
# For local development outside Docker, use localhost:5432
# For Docker deployment, use postgres:5432 (service name)
DATABASE_URL=postgresql+asyncpg://logs:logs_dev_password@postgres:5432/logs_manager

# Redis
REDIS_URL=redis://localhost:6379

# Auth
ACCESS_TOKEN_SECRET=dev_access_secret_change_me_in_production
REFRESH_TOKEN_SECRET=dev_refresh_secret_change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Email (SMTP or Resend)
SMTP_ENABLED=false
OTP_EMAIL_ENABLED=true
ALERT_EMAIL_ENABLED=true
EMAIL_PROVIDER=resend
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
ALERT_EMAIL_RECIPIENTS=
# Resend HTTPS API (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Ingestion (per-tenant API keys managed via /api/tenants)
INGEST_API_USERNAME=log-forwarder
INGEST_DEFAULT_TENANT=demoA
INGEST_BATCH_MAX_EVENTS=1000
INGEST_MAX_FILE_BYTES=10485760
# Syslog-over-HTTPS (SaaS) limits
INGEST_HTTP_SYSLOG_MAX_BYTES=1048576
INGEST_HTTP_SYSLOG_MAX_LINES=1000
INGEST_RATE_LIMIT=600/minute

# Syslog
SYSLOG_ENABLED=true
SYSLOG_TENANT=demoA
SYSLOG_SOURCE=firewall
SYSLOG_USERNAME=syslog
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
# Timezone policy for naive RFC3164 timestamps: UTC (default) | local | IANA name
SYSLOG_TIMEZONE=UTC

# Retention
RETENTION_DAYS=7
RETENTION_SCHEDULE=0 5 * * *
RETENTION_INTERVAL_MINUTES=60
RETENTION_RUN_ON_STARTUP=true

# Alert webhook (optional)
ALERT_WEBHOOK_URL=

# Rate limiting (login brute-force protection)
LOGIN_RATE_LIMIT=5/minute
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8080"]