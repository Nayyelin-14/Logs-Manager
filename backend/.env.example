NODE_ENV=development
PORT=4500
CORS_ORIGINS=http://localhost:5173

ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Neon PostgreSQL (Project -> Dashboard -> Connect -> Connection string)
# Direct connection (recommended for local dev + Prisma migrations):
#   postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#
# Pooled connection (use for serverless / many short-lived clients):
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@your-redis-host:6379
# Optional separate values if REDIS_URL is not used
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Gmail account for sending emails via Nodemailer
# Create an App Password (Google Account -> Security -> App passwords)
GMAIL_USER=your_gmail_user_here
GMAIL_PASS=your_gmail_password_here

# Machine ingestion (API key for POST /api/ingest and /api/ingest/batch)
# Single key + its bound tenant:
INGEST_API_KEY=change_me_to_a_long_random_value
INGEST_API_TENANT=demoA
INGEST_API_USERNAME=log-forwarder
# Optional multiple keys as JSON (key -> tenant or key -> {tenant,username,email}):
# INGEST_API_KEYS={"key_one":"tenantA","key_two":{"tenant":"tenantB","username":"aws-agent"}}
INGEST_DEFAULT_TENANT=demoA
INGEST_BATCH_MAX_EVENTS=1000
INGEST_MAX_FILE_BYTES=10485760

# Syslog listeners
SYSLOG_ENABLED=false
SYSLOG_TENANT=demoA
SYSLOG_SOURCE=firewall
SYSLOG_USERNAME=syslog
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=514
# Optional bind addresses (default: all interfaces)
# SYSLOG_UDP_HOST=0.0.0.0
# SYSLOG_TCP_HOST=0.0.0.0
