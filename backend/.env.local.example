# FastAPI Local Development - Template
# Copy to .env.local and fill in your real values

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=4501

# Database
# Your Neon connection string for local development
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@host.neon.tech/db?sslmode=require

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379

# Auth - JWT secrets (required, must be long random strings in production)
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Token expiry times
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# JWT algorithm
JWT_ALGORITHM=HS256

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Trusted hosts (for production)
ALLOWED_HOSTS=["localhost", "127.0.0.1", "*.your-domain.com"]

# Database pool mode
DATABASE_POOL=queue

# Email (SMTP)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Ingestion (per-tenant API keys managed via /api/tenants)
INGEST_API_USERNAME=log-forwarder
INGEST_DEFAULT_TENANT=demoA

# Syslog
SYSLOG_ENABLED=true
SYSLOG_TENANT=demoA
SYSLOG_SOURCE=firewall
SYSLOG_USERNAME=syslog
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
SYSLOG_TIMEZONE=UTC

# Retention
RETENTION_DAYS=7
RETENTION_SCHEDULE=0 5 * * *