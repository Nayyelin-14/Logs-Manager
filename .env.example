# -----------------------
# Backend Environment
# -----------------------

# Port your backend server runs on
PORT=4500

# JWT secrets
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Neon PostgreSQL connection string (direct connection)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Redis (for caching or session management)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Gmail account for sending emails via Nodemailer
GMAIL_USER=your_gmail_user_here
GMAIL_PASS=your_gmail_password_here

# -----------------------
# Frontend Environment
# -----------------------

# Backend API URL (used by frontend to call backend endpoints)
VITE_API_URL=http://localhost:4500/api
# If backend is deployed elsewhere, replace the value above with that URL, e.g.
# VITE_API_URL=https://your-backend-url.com/api
# -----------------------
# Machine ingestion
# -----------------------
INGEST_API_KEY=change_me_to_a_long_random_value
INGEST_API_TENANT=demoA
INGEST_API_USERNAME=log-forwarder
# Optional multiple keys: {"key_one":"tenantA","key_two":{"tenant":"tenantB"}}
# INGEST_API_KEYS=
INGEST_DEFAULT_TENANT=demoA
INGEST_BATCH_MAX_EVENTS=1000
INGEST_MAX_FILE_BYTES=10485760

# Syslog listeners (514 needs root or a port override)
SYSLOG_ENABLED=false
SYSLOG_TENANT=demoA
SYSLOG_SOURCE=firewall
SYSLOG_USERNAME=syslog
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=514
# SYSLOG_UDP_HOST=0.0.0.0
# SYSLOG_TCP_HOST=0.0.0.0
