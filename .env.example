APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=4500
SAAS_MODE=false

DATABASE_URL=postgresql+asyncpg://logs:postgres_pass@db:5432/logs_manager?sslmode=disable
DATABASE_POOL=queue

REDIS_URL=redis://redis:6379

ACCESS_TOKEN_SECRET=your_access_token_secret_change_me_in_production
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

SMTP_ENABLED=false
OTP_EMAIL_ENABLED=true
ALERT_EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
ALERT_EMAIL_RECIPIENTS=

# Email provider selection: "smtp" or "resend"
EMAIL_PROVIDER=resend
# Master switch for outbound alert email. Disabled until a provider is configured.
EMAIL_ENABLED=false
# Resend HTTPS API configuration (used when EMAIL_PROVIDER=resend)
# Obtain the API key from the Resend dashboard; never commit it.
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

INGEST_API_KEY=dev-ingest-key-change-me
INGEST_API_USERNAME=log-forwarder
INGEST_DEFAULT_TENANT=demoA
INGEST_BATCH_MAX_EVENTS=1000
INGEST_MAX_FILE_BYTES=10485760
# Syslog-over-HTTPS (SaaS) limits.
INGEST_HTTP_SYSLOG_MAX_BYTES=1048576
INGEST_HTTP_SYSLOG_MAX_LINES=1000
INGEST_RATE_LIMIT=600/minute

SYSLOG_ENABLED=true
SYSLOG_TENANT=demoA
SYSLOG_SOURCE=firewall
SYSLOG_USERNAME=syslog
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
SYSLOG_TIMEZONE=UTC

# Host interface for the published 514 ports. Set this to a private/LAN
# address (for example 10.0.0.5) so port 514 is never reachable from the
# public Internet. Never publish 514 on a public interface; allowlist the
# forwarding devices in the host firewall and optionally in
# SYSLOG_ALLOWED_CIDRS below.
SYSLOG_BIND_IP=0.0.0.0
# Interface the native listener binds to inside the container. Leave at
# 0.0.0.0 so Docker's host port mapping can reach it.
SYSLOG_CONTAINER_BIND_IP=0.0.0.0
# Optional comma-separated source CIDRs for native UDP/TCP Syslog.
# Empty means no application-level filtering (rely on the firewall).
SYSLOG_ALLOWED_CIDRS=
# Bounded retry for transient database failures in the native listener.
SYSLOG_DB_RETRY_ATTEMPTS=3
SYSLOG_DB_RETRY_BACKOFF_SECS=0.25
# Maximum concurrent in-flight UDP datagrams.
SYSLOG_MAX_INFLIGHT=1000
# Loopback-only health endpoint used by the ingest container health check.
INGEST_HEALTH_PORT=8090
# Host port exposed for Syslog UDP/TCP. Default 514 is the traditional
# firewall/router syslog port; the container always listens on 5514.
# Use 5514 on Docker Desktop/WSL2 (where binding low ports can fail) or when
# host port 514 is already in use: set SYSLOG_HOST_PORT=5514 in your local .env.
SYSLOG_HOST_PORT=514

RETENTION_DAYS=7
RETENTION_SCHEDULE="0 5 * * *"
RETENTION_INTERVAL_MINUTES=60
RETENTION_RUN_ON_STARTUP=true

WORKER_EMBEDDED=false
ALERT_SWEEP_INTERVAL=30
ALERT_WEBHOOK_URL=http://webhook-receiver:8000/webhook

LOGIN_RATE_LIMIT=5/minute
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

CORS_ORIGINS='["http://localhost:5173", "http://localhost:8080"]'

ALLOWED_HOSTS='["localhost", "127.0.0.1", "*.logmanager.local"]'

DOMAIN=
CADDY_EMAIL=admin@example.com

# Address Caddy binds to on the host.
#   127.0.0.1 (default) = local laptop only.
#   0.0.0.0            = reachable from the LAN or a VM. Set DOMAIN to a DNS
#                        name pointing at this host so Caddy can obtain a TLS
#                        certificate. For a LAN-only host use its hostname/IP
#                        and expect Caddy's internal certificate warning.
CADDY_BIND_IP=127.0.0.1

HTTP_PORT=80
HTTPS_PORT=443
WEBHOOK_PORT=8008
DB_HOST_PORT=55432
REDIS_HOST_PORT=56379
BACKEND_HOST_PORT=4500

VITE_API_URL=/api

POSTGRES_USER=logs
POSTGRES_PASSWORD=postgres_pass
POSTGRES_DB=logs_manager

SEED_ADMIN_PASSWORD=
SEED_VIEWER_A_PASSWORD=
SEED_VIEWER_B_PASSWORD=