# =============================================================================
# Logs Manager — Environment Configuration (.env.example)
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit real secrets. .env and .env.local must be in .gitignore.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=4500
SAAS_MODE=false

# --- Database (PostgreSQL) ---
# Docker compose: postgresql+asyncpg://logs:postgres_pass@db:5432/logs_manager
# Neon (cloud/dev): use direct (non-pooled) URL in .env.local
DATABASE_URL=postgresql+asyncpg://logs:postgres_pass@db:5432/logs_manager?sslmode=disable

# Database pool: "queue" (default) or "null" (one connection per checkout, for tests)
DATABASE_POOL=queue

# --- Redis (cache + email queue) ---
# Docker compose: redis://redis:6379
# Upstash (cloud/dev): rediss://... in .env.local
REDIS_URL=redis://redis:6379

# --- Authentication (JWT) ---
# Generate: openssl rand -hex 32
# In SaaS mode, backend refuses to start with default/empty secrets.
ACCESS_TOKEN_SECRET=your_access_token_secret_change_me_in_production
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Email (SMTP) ---
SMTP_ENABLED=false
OTP_EMAIL_ENABLED=true
ALERT_EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
ALERT_EMAIL_RECIPIENTS=

# --- Ingestion API ---
# Generate: openssl rand -hex 32
INGEST_API_KEY=dev-ingest-key-change-me
INGEST_API_USERNAME=log-forwarder
INGEST_DEFAULT_TENANT=demoA
INGEST_BATCH_MAX_EVENTS=1000
INGEST_MAX_FILE_BYTES=10485760

# --- Syslog Listeners ---
SYSLOG_ENABLED=true
SYSLOG_TENANT=demoA
SYSLOG_SOURCE=firewall
SYSLOG_USERNAME=syslog
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
SYSLOG_TIMEZONE=UTC

# --- Retention ---
RETENTION_DAYS=7
RETENTION_SCHEDULE="0 5 * * *"

# --- Worker ---
# false when a dedicated `worker` service runs (default compose topology).
# true only for single-process/embedded deployments.
WORKER_EMBEDDED=false
ALERT_SWEEP_INTERVAL=30
# Demo alert rule webhook target (in-compose receiver)
ALERT_WEBHOOK_URL=http://webhook-receiver:8000/webhook

# --- CORS ---
CORS_ORIGINS='["http://localhost:5173", "http://localhost:8081"]'

# --- Trusted Hosts ---
ALLOWED_HOSTS='["localhost", "127.0.0.1", "*.logmanager.local"]'

# --- Caddy / SaaS TLS ---
# Set DOMAIN to your public domain for automatic Let's Encrypt.
# localhost / an IP / empty uses Caddy's internal CA automatically.
DOMAIN=
CADDY_EMAIL=admin@example.com

# --- Host Ports ---
# Default for appliance/on-prem deployment.
# SaaS deployment should NOT expose these (use docker-compose.saas.yml override).
# These ports bind to 127.0.0.1 only by default using alternate ports to avoid conflicts.
# Set to standard ports if your host ports 5432, 6379, 4500, 8081, 8000 are free.
HTTP_PORT=80
HTTPS_PORT=443
WEBHOOK_PORT=8000
SYSLOG_HOST_PORT=514
DB_HOST_PORT=55432
REDIS_HOST_PORT=56379
BACKEND_HOST_PORT=4500
FRONTEND_HOST_PORT=8081

# --- Frontend ---
# Docker/nginx: VITE_API_URL=/api
# Local dev: VITE_API_URL=http://localhost:4500/api
VITE_API_URL=/api

# --- Postgres (container) ---
POSTGRES_USER=logs
POSTGRES_PASSWORD=postgres_pass
POSTGRES_DB=logs_manager

# --- Demo seed passwords ---
# Required in SaaS mode; generated randomly and printed once in appliance mode.
# Set these to your desired test passwords (min 12 chars recommended).
SEED_ADMIN_PASSWORD=
SEED_VIEWER_A_PASSWORD=
SEED_VIEWER_B_PASSWORD=