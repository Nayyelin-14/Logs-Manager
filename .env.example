# Logs Manager - environment template (FastAPI + React/Vite)
#
# The canonical stack is defined by backend-fastapi/docker-compose.yml, which
# sets the container environment inline. This template documents the variables
# understood by the FastAPI backend and the React frontend.
#
# Local backend development: copy to backend-fastapi/.env and edit
# (./run.sh creates it automatically when missing and never overwrites):
#   cp .env.example backend-fastapi/.env

# -----------------------
# FastAPI backend (backend-fastapi/)
# -----------------------

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=4500

# Database (async SQLAlchemy + Alembic)
# For local development outside Docker, use localhost:5432
# For Docker deployment, use postgres:5432 (service name)
DATABASE_URL=postgresql+asyncpg://logs:logs_dev_password@localhost:5432/logs_manager
# Database connection pool mode: "queue" (default) or "null" (NullPool for tests)
DATABASE_POOL=queue

# Redis
REDIS_URL=redis://localhost:6379

# Auth (JWT access/refresh + HTTP-only cookies)
ACCESS_TOKEN_SECRET=dev_access_secret_change_me_in_production
REFRESH_TOKEN_SECRET=dev_refresh_secret_change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Email - NOT enabled by default (SMTP off, no background worker running).
# OTP and alert emails are enqueued but never delivered until enabled.
SMTP_ENABLED=false
OTP_EMAIL_ENABLED=true
ALERT_EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
ALERT_EMAIL_RECIPIENTS=

# Machine ingestion (per-tenant API keys managed via /api/tenants)
INGEST_API_USERNAME=log-forwarder
INGEST_DEFAULT_TENANT=demoA
INGEST_BATCH_MAX_EVENTS=1000
INGEST_MAX_FILE_BYTES=10485760

# Syslog listeners (appliance exposes 5514/udp+tcp; 514 needs root)
SYSLOG_ENABLED=true
SYSLOG_TENANT=demoA
SYSLOG_SOURCE=firewall
SYSLOG_USERNAME=syslog
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
# Timezone policy for naive RFC3164 timestamps: UTC (default) | local | IANA name
SYSLOG_TIMEZONE=UTC

# Retention (raw log purge; 7-day default, daily cron)
RETENTION_DAYS=7
RETENTION_SCHEDULE=0 5 * * *

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8080"]

# Trusted hosts (for TrustedHostMiddleware in production)
ALLOWED_HOSTS=["localhost", "127.0.0.1", "*.logmanager.local"]

# -----------------------
# React frontend (frontend/lms/)
# -----------------------
# /api when served behind the bundled nginx proxy (Docker, http://localhost:8081).
# For `npm run dev` (Vite on 5173) use the full backend URL instead, e.g.
# VITE_API_URL=http://localhost:4500/api
VITE_API_URL=/api
