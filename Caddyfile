# Caddyfile — Logs Manager reverse proxy with TLS
# DOMAIN env var controls certificate source:
#   - Public domain: automatic Let's Encrypt
#   - localhost / IP / empty: Caddy's internal CA (self-signed)
# HTTP → HTTPS redirect is always enforced.

{
    admin localhost:2019
}

# HTTP → HTTPS redirect
:80 {
    redir https://{host}{uri} 308
}

# Main site. {$DOMAIN:localhost} uses Caddy's env placeholder default syntax
# (required for site addresses; {env.DOMAIN} is only a directive placeholder).
{$DOMAIN:localhost} {
    reverse_proxy /api/* backend:4500
    reverse_proxy /ingest/* backend:4500
    reverse_proxy /ingest backend:4500
    reverse_proxy /auth/* backend:4500
    reverse_proxy /docs/* backend:4500
    reverse_proxy /openapi.json backend:4500
    reverse_proxy /webhook webhook-receiver:8000
    reverse_proxy /* frontend:80

    encode gzip zstd

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
